import math


def show_menu():
    print("\n==============================")
    print("       PYTHON CALCULATOR")
    print("==============================")
    print("1. Addition")
    print("2. Subtraction")
    print("3. Multiplication")
    print("4. Division")
    print("5. Power")
    print("6. Square Root")
    print("7. Percentage")
    print("8. Calculation History")
    print("9. Exit")
    print("==============================")


def get_number(prompt):
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Please enter a valid number.")


def addition():
    a = get_number("First number: ")
    b = get_number("Second number: ")
    result = a + b

    print(f"Result: {a} + {b} = {result}")
    return f"{a} + {b} = {result}"


def subtraction():
    a = get_number("First number: ")
    b = get_number("Second number: ")
    result = a - b

    print(f"Result: {a} - {b} = {result}")
    return f"{a} - {b} = {result}"


def multiplication():
    a = get_number("First number: ")
    b = get_number("Second number: ")
    result = a * b

    print(f"Result: {a} × {b} = {result}")
    return f"{a} × {b} = {result}"


def division():
    a = get_number("First number: ")
    b = get_number("Second number: ")

    if b == 0:
        print("Error: Cannot divide by zero.")
        return None

    result = a / b

    print(f"Result: {a} ÷ {b} = {result}")
    return f"{a} ÷ {b} = {result}"


def power():
    a = get_number("Base: ")
    b = get_number("Exponent: ")
    result = a ** b

    print(f"Result: {a}^{b} = {result}")
    return f"{a}^{b} = {result}"


def square_root():
    a = get_number("Number: ")

    if a < 0:
        print("Error: Cannot calculate the square root of a negative number.")
        return None

    result = math.sqrt(a)

    print(f"Result: √{a} = {result}")
    return f"√{a} = {result}"


def percentage():
    number = get_number("Number: ")
    percent = get_number("Percentage: ")

    result = number * (percent / 100)

    print(f"Result: {percent}% of {number} = {result}")
    return f"{percent}% of {number} = {result}"


def show_history(history):
    print("\n========== HISTORY ==========")

    if not history:
        print("No calculations yet.")
        return

    for i, calculation in enumerate(history, start=1):
        print(f"{i}. {calculation}")


def main():
    history = []

    while True:
        show_menu()

        choice = input("Choose an option: ").strip()

        calculation = None

        if choice == "1":
            calculation = addition()

        elif choice == "2":
            calculation = subtraction()

        elif choice == "3":
            calculation = multiplication()

        elif choice == "4":
            calculation = division()

        elif choice == "5":
            calculation = power()

        elif choice == "6":
            calculation = square_root()

        elif choice == "7":
            calculation = percentage()

        elif choice == "8":
            show_history(history)

        elif choice == "9":
            print("\nThanks for using Python Calculator!")
            break

        else:
            print("Invalid option. Please choose 1-9.")

        if calculation is not None:
            history.append(calculation)


if __name__ == "__main__":
    main()
